{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Reader": {
    "Hostname": "192.168.1.10",
    "AutoConnect": false,
    "ConnectTimeoutMs": 5000,
    "MessageTimeoutMs": 5000,
    "AntennaPorts": [ 1 ],
    "MaxTxPower": true,
    "TxPowerInDbm": null,
    "MaxRxSensitivity": true,
    "RxSensitivityInDbm": null,
    "RfMode": 1002,
    "SearchMode": "DualTarget",
    "Session": 2,
    "MaxRecentTags": 500,
    "TagSnapshotExpirySeconds": 10
  }
}
